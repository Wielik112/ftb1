# Skopiuj ten plik do .env i uzupełnij wartości.

# Połączenie do bazy PostgreSQL (Neon / Supabase / lokalny Postgres).
# W Neon/Supabase skopiuj gotowy "connection string".
DATABASE_URL="postgresql://user:password@host:5432/fbt?sslmode=require"

# Hasło do logowania w panelu /admin.
ADMIN_PASSWORD="zmien-to-haslo"

# Sekret do podpisywania ciasteczka sesji admina — dowolny długi, losowy ciąg.
# Możesz wygenerować np.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="wygeneruj-dlugi-losowy-ciag-znakow"
